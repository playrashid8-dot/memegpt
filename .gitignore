# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Hardhat / Solidity build outputs (never at website root)
/artifacts/
/cache/
/typechain-types/
/coverage/
/coverage.json
/deployments/
/hardhat.config.ts
/contracts/

# MEMEGPT token (Hardhat) — separate package under memegpt-token/
memegpt-token/node_modules/
memegpt-token/artifacts/
memegpt-token/cache/
memegpt-token/typechain-types/
memegpt-token/coverage/
memegpt-token/deployments/
memegpt-token/.env
